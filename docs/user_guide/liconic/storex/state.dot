digraph StoreX {
  rankdir=LR;
  node [shape=box];
  slot [label="Confirmed source"];
  shovel [label="Confirmed shovel"];
  destination [label="Confirmed destination"];
  uncertain [label="Unresolved transfer\nFurther handling blocked"];
  slot -> shovel [label="pick + ready + sensors"];
  shovel -> destination [label="place + ready + sensors"];
  slot -> uncertain [label="interrupted pick"];
  shovel -> uncertain [label="interrupted place"];
  uncertain -> slot [label="inspect + reconcile source"];
  uncertain -> shovel [label="inspect + reconcile shovel"];
  uncertain -> destination [label="inspect + reconcile destination"];
}
